# Force tout en LF, sauf fichiers batch/powershell Windows

# Global : LF par défaut
* text=auto eol=lf

# CRLF pour scripts Windows
*.bat     text eol=crlf

# Kotlin, Java
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf

# Fichiers de config/app
*.yml     text eol=lf
*.yaml    text eol=lf
*.properties text eol=lf
*.conf    text eol=lf

# Migration SQL
*.sql     text eol=lf

# Documentation
*.md      text eol=lf
*.txt     text eol=lf

# Dossiers de configuration IDE (par sécurité)
.idea/*   text eol=lf
.vscode/* text eol=lf