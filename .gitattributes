# Normalize line endings to LF on commit (critical on Windows)
* text=auto eol=lf

# Backend
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.gradle  text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf
*.properties text eol=lf

# Frontend
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf

# Binary — no line ending conversion
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.otf     binary
*.zip     binary
*.jar     binary
*.class   binary