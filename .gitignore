# ─── Backend (Kotlin / Gradle) ───────────────────────────────────────────────
.gradle/
build/
out/
*.class
*.jar
*.war
*.ear
*.nar
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ — ignore machine-local noise; allow shared code style & inspections
.idea/*
!.idea/codeStyles/
!.idea/codeStyles/**
!.idea/inspectionProfiles/
!.idea/inspectionProfiles/**
!.idea/runConfigurations/
!.idea/runConfigurations/**
*.iml
*.iws
*.ipr

# Kotlin
*.kotlin_module

# Logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# ─── Frontend (Next.js / Node) ───────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/.swc/
frontend/out/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/junit-results/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ─── Environment — NEVER commit secrets ──────────────────────────────────────
.env
.env.local
.env*.local
**/.env.local
**/.env*.local

# ─── Editor ──────────────────────────────────────────────────────────────────
# VS Code — keep team recommendations & workspace settings; ignore local-only files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
